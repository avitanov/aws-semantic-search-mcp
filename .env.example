AWS_REGION="us-east-1"
AWS_PROFILE="set-up-your-profile-here"
ACCOUNT="set-up-your-aws-account-id-here"      # aws sts get-caller-identity --query Account --output text

# --- phase 1: source PDFs ---
DOCS_BUCKET="set-up-your-bucket-here"
DOCS_PREFIX="your-name/raw/"                   # trailing slash matters

# --- phase 1: S3 Vectors destination (created by ingest.py if missing) ---
VECTOR_BUCKET="your-name-mk-interns-lab1-vectors"   # unique per account+region
VECTOR_INDEX="articles"

# --- phases 1-2: Bedrock embedding model ---
EMBED_MODEL="set-up-your-bedrock-embedding-model-here"  # e.g. amazon.titan-embed-text-v2:0
EMBED_DIM="set-up-your-bedrock-embedding-dimension-here"  # e.g. 1024

# --- phase 4: deployment ---
ECR_REPO="your-name-mk-interns-lab1-mcp"
IMAGE_TAG="v1"
ROLE_NAME="your-name-mk-interns-lab1-agentcore-role"
RUNTIME_NAME="your_name_article_search_mcp"    # letters, digits, underscores only -- no hyphens
AGENT_RUNTIME_ARN=""                           # fill in after step 8.4 creates the runtime
PROJECT_TAG="ml-interns-mk-2026"               # tag an SCP requires on every created resource

# --- phase 4: derived, do not edit (this file is sourced by bash) ---
REGISTRY="${ACCOUNT}.dkr.ecr.${AWS_REGION}.amazonaws.com"
IMAGE="${REGISTRY}/${ECR_REPO}:${IMAGE_TAG}"
